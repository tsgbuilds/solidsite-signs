PORT=3000
HOST=0.0.0.0
# Set to your final HTTPS origin before production launch.
SITE_URL=
# In production, point this to a mounted persistent volume.
DATA_DIR=./data
# Set to a random secret of at least 32 characters to enable the private leads API.
ADMIN_TOKEN=
# Leave 0 unless the reverse proxy replaces X-Forwarded-For with a trusted client IP.
TRUST_PROXY=0
# Production on solidsitesigns.com defaults to its dedicated saved-inquiry action.
# Optional override: exactly AW-<id>/<label> from Google Ads; empty disables it.
# GOOGLE_ADS_CONVERSION_SEND_TO=
